# ===== LR Dashboard — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env) =====
# ---- ฐานข้อมูล HOSxP (ผู้ใช้อ่านอย่างเดียว) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=5400
# direct = ต่อ DB ตรง (production) · ssh = ยิงผ่าน `ssh <host> mariadb` (dev ไม่มีรหัส DB)
LR_DB_MODE=
LR_SSH_HOST=
LR_DB_TIMEOUT=60

# ---- ทั่วไป ----
# ชื่อโรงพยาบาลบนหัวหน้า (ว่าง = อ่านจาก opdconfig.hospitalname ของ HOSxP)
LR_HOSPITAL_NAME=
LR_DEV_CONTACT=
# แคชผลคำนวณ (วินาที)
LR_CACHE_TTL=300
# 1 = ตรวจข้อมูลของ รพ. นี้แล้ว (ซ่อนแถบเตือน "ตัวเลขยังไม่ได้ตรวจ") — ตั้งหลังทำตาม INSTALL.md ข้อ 0
LR_DATA_AUDITED=
# 0 = ปิดปุ่มส่งออก JPG/PDF (ไม่ต้องมี Chrome) · 1 = ปิด sandbox ของ chromium (container ที่ไม่รองรับ)
LR_EXPORT=1
LR_CHROME_NO_SANDBOX=

# ---- หน้ารายชื่อ (มีข้อมูลผู้ป่วย) — ไม่ตั้ง LR_SECRET_KEY = ปิดทั้งหมด ----
# python -c "import secrets; print(secrets.token_hex(32))"
LR_SECRET_KEY=
LR_COOKIE_SECURE=0
# ค่าเริ่มต้น = เฉพาะเครื่องใน รพ. (ข้อมูลผู้ป่วยต้องไม่ออกอินเทอร์เน็ต) · ตั้ง 0 เพื่อปิดข้อจำกัดนี้เอง
LR_LIST_LAN_ONLY=1
# passkey = รหัสผ่านร่วมของหน่วย เข้าดูรายชื่อได้โดยไม่ต้องมีบัญชีรายคน (ว่าง = ปิด) · audit log จะลงชื่อว่า "passkey"
# ไม่รู้ว่าใครเปิดดู จึงควรใช้คู่กับ LR_LIST_LAN_ONLY=1 และตั้งค่ายาว ๆ · เปลี่ยนค่าแล้ว restart = ทุกคนต้องใส่ใหม่
# ห้ามใช้ค่าเดียวกับ LR_SECRET_KEY (ตัวนั้นใช้เซ็น session)
LR_PASSKEY=
LR_DATA_DIR=

# หน้าแดชบอร์ด/รายปีที่คนนอก รพ. (ไม่ได้ login) เห็น: ช่วงกำหนดเองปัดเป็นเดือนเต็ม และตัวเลขภาวะแทรกซ้อน/HIV/Syphilis/
#   Hep B/สารเสพติด/การเสียชีวิต ที่น้อยกว่าค่านี้แสดงเป็น "<5" · เครื่องใน LAN / ผู้ที่ login เห็นตัวเลขเต็ม · 0 = ปิด (ไม่แนะนำ)
LR_PUBLIC_MIN_CELL=5

# ---- หน้า /check (เปิดเฉพาะ LAN) ----
LR_CHECK_OPEN=0
# เครือข่ายภายใน รพ. ที่ไม่ใช่ที่อยู่ส่วนตัวตาม RFC1918 (เช่น 30.25.1.0/24 — หลายช่วงคั่นด้วยจุลภาค) — เครื่องใน LAN จึงจะเปิด /check และรายชื่อได้
LR_LAN_NETS=
LR_TRUSTED_PROXIES=127.0.0.1,::1
LR_CF_RANGES=

# ---- รหัสที่แต่ละ รพ. อาจต่างกัน — ตรวจที่หน้า /check แล้วแก้ให้ตรง ----
# หลักฐานว่าเป็น "การคลอด" (ICD-10 3 ตัวแรก) — ใช้ตัดแถวรอคลอด/ไม่คลอดใน ipt_pregnancy
LR_DELIVERY_ICD10=O80,O81,O82,O83,O84,Z37
# คลอดปกติ
LR_NORMAL_ICD=O80
# หัตถการ: ผ่าท้อง/คีม/สุญญากาศ/ท่าก้น (ICD-9 เป็น prefix · ICD-10 ไม่ใส่จุด)
LR_CS_ICD9=74
LR_FORCEPS_ICD9=720,721,722,723,724
LR_FORCEPS_ICD10=O810,O811,O812,O813
LR_VACUUM_ICD9=727
LR_VACUUM_ICD10=O814
LR_BREECH_ICD9=725
LR_BREECH_ICD10=O830,O831
# ทารกเกิดไร้ชีพ (Dx) · infant_dchstts ที่หมายถึงเสียชีวิต (master dchstts: 08 Dead Still Birth, 09 Dead)
LR_STILLBIRTH_ICD10=P95,Z371,Z373,Z374,Z376
LR_DEAD_DCHSTTS=08,09
# infant_dchstts ที่หมายถึงตายคลอด (ใช้นับ 'เด็กเกิดไร้ชีพ') · ที่เหลือใน LR_DEAD_DCHSTTS = เสียชีวิตหลังเกิด
LR_STILLBIRTH_DCHSTTS=08
# infant_delivery_type_id ที่หมายถึงคลอดก่อนถึง รพ. (BBA)
LR_BBA_TYPES=3
# Apgar 1 นาที ≤ ค่านี้ นับเป็นคะแนนต่ำ · ขาดออกซิเจน: Apgar 5 นาที < ค่านี้ หรือ Dx
LR_APGAR1_MAX=7
LR_ASPHYXIA_APGAR5=7
LR_ASPHYXIA_ICD10=P21
# ทารกน้ำหนักน้อย: < กรัม
LR_LBW_GRAMS=2500
# Dx ภาวะแทรกซ้อน (ขึ้นต้นด้วย)
LR_DX_PPH=O72
LR_DX_PRETERM=O60
LR_DX_HTN=O13,O14,O15,O16
LR_DX_PROLONGED=O63
LR_DX_FETAL_DISTRESS=O68
LR_DX_PROM=O42
# lab ตอนคลอด: syphilis/hiv/hbv = labour_lab.lab_id ใน ipt_labour_lab · amph = lab_items_code ใน lab_order
LR_LAB_SYPHILIS=1
LR_LAB_HIV=2
LR_LAB_HBV=3
LR_LAB_AMPH=139,590,2104,1992
# lab_items_code ของ VDRL/TPHA · Anti-HIV · HBsAg ใน lab_order ตลอดการตั้งครรภ์ (ว่าง = เลือกจากชื่อรายการ — ตรวจที่ /check)
LR_LAB_SYPHILIS_ITEMS=
LR_LAB_HIV_ITEMS=
LR_LAB_HBV_ITEMS=
# หน้าต่างเวลาจับผล lab/แบบคัดกรองของมารดา: กี่วันก่อนวันคลอด · กี่วันหลังวันคลอด
LR_LAB_WINDOW_BEFORE=300
LR_LAB_WINDOW_AFTER=7
# ข้อของแบบคัดกรองครรภ์เสี่ยง (person_anc_classifying_item) "ติดยาเสพติด ติดสุรา" — แถว "มารดาติดสุรา/ยาเสพติด"
LR_SUBSTANCE_FORM_ITEMS=17
